# ==============================================================================
# NuKlean Backend - Environment Configuration Template
# Copy this file to '.env' and fill in your actual values.
# ==============================================================================

# Database Connection (Production)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:port/database_name
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# Database connection options
SPRING_JPA_SHOW_SQL=false
TOMCAT_MAX_THREADS=15
SPRING_LAZY_INIT=true

# Security & JWT Tokens
# Generate a secure 256-bit key for JWT signatures
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=2592000000

# Third-party Integrations
MINIMOTH_API_KEY=your_minimoth_api_key

# Payment Gateway (PhonePe)
PAYMENT_DEV_MODE=true
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1
PHONEPE_API_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Google Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Initial Administrator Credentials
ADMIN_PHONE=910000000000
ADMIN_PASSWORD=your_admin_password
ADMIN_FULL_NAME=Administrator
